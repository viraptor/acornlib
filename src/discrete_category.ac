/// The discrete category on a type, where the only morphisms are identities.

from category import Category, is_category, category_id_endpoints_constraint,
    category_compose_src_constraint, category_compose_dst_constraint,
    category_assoc_constraint, category_id_left_constraint, category_id_right_constraint
from functions import identity_fn

/// Composition for the discrete category, defined as the outer morphism.
/// On composable pairs the two arguments are equal, so this picks the unique morphism.
define discrete_compose[O](f: O, g: O) -> O {
    f
}

/// The discrete data on `O` satisfies the category axioms.
theorem discrete_is_category[O](anchor: O) {
    is_category(identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O])
} by {
    forall(x: O) {
        identity_fn[O](identity_fn[O](x)) = x
        identity_fn[O](x) = x
    }
    category_id_endpoints_constraint(identity_fn[O], identity_fn[O], identity_fn[O])
    forall(f: O, g: O) {
        if identity_fn[O](f) = identity_fn[O](g) {
            f = g
            discrete_compose[O](f, g) = f
            identity_fn[O](discrete_compose[O](f, g)) = identity_fn[O](g)
        }
    }
    category_compose_src_constraint(identity_fn[O], identity_fn[O], discrete_compose[O])
    forall(f: O, g: O) {
        if identity_fn[O](f) = identity_fn[O](g) {
            f = g
            discrete_compose[O](f, g) = f
            identity_fn[O](discrete_compose[O](f, g)) = identity_fn[O](f)
        }
    }
    category_compose_dst_constraint(identity_fn[O], identity_fn[O], discrete_compose[O])
    forall(f: O, g: O, h: O) {
        if identity_fn[O](f) = identity_fn[O](g) and identity_fn[O](g) = identity_fn[O](h) {
            f = g
            g = h
            discrete_compose[O](discrete_compose[O](f, g), h) = f
            discrete_compose[O](f, discrete_compose[O](g, h)) = f
        }
    }
    category_assoc_constraint(identity_fn[O], identity_fn[O], discrete_compose[O])
    forall(f: O) {
        discrete_compose[O](identity_fn[O](identity_fn[O](f)), f) = identity_fn[O](identity_fn[O](f))
        identity_fn[O](identity_fn[O](f)) = f
    }
    category_id_left_constraint(identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O])
    forall(f: O) {
        discrete_compose[O](f, identity_fn[O](identity_fn[O](f))) = f
    }
    category_id_right_constraint(identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O])
}

/// Construction of a category remembers its source map.
theorem category_new_src[O, M](
    s: M -> O, d: M -> O, ident: O -> M, comp: (M, M) -> M, c: Category[O, M]
) {
    Category[O, M].new(s, d, ident, comp) = Option.some(c) implies c.src = s
}

/// Construction of a category remembers its target map.
theorem category_new_dst[O, M](
    s: M -> O, d: M -> O, ident: O -> M, comp: (M, M) -> M, c: Category[O, M]
) {
    Category[O, M].new(s, d, ident, comp) = Option.some(c) implies c.dst = d
}

/// Construction of a category remembers its identity map.
theorem category_new_identity[O, M](
    s: M -> O, d: M -> O, ident: O -> M, comp: (M, M) -> M, c: Category[O, M]
) {
    Category[O, M].new(s, d, ident, comp) = Option.some(c) implies c.identity = ident
}

/// Construction of a category remembers its composition.
theorem category_new_compose[O, M](
    s: M -> O, d: M -> O, ident: O -> M, comp: (M, M) -> M, c: Category[O, M]
) {
    Category[O, M].new(s, d, ident, comp) = Option.some(c) implies c.compose = comp
}

/// The discrete category on a type, with one identity morphism per object.
let discrete_category[O](anchor: O) -> result: Category[O, O] satisfy {
    result.src = identity_fn[O]
    and result.dst = identity_fn[O]
    and result.identity = identity_fn[O]
    and result.compose = discrete_compose[O]
} by {
    discrete_is_category(anchor)
    let c: Category[O, O] satisfy {
        Category[O, O].new(identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O]) = Option.some(c)
    }
    category_new_src(identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O], c)
    category_new_dst(identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O], c)
    category_new_identity(identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O], c)
    category_new_compose(identity_fn[O], identity_fn[O], identity_fn[O], discrete_compose[O], c)
}

// NOTE: per-field accessor theorems on `discrete_category(anchor)` (e.g.
// `discrete_category(anchor).src = identity_fn[O]`) time out for the prover even
// though the `satisfy` clause pins all four fields. Callers should bind the result
// and use the satisfy clause directly when they need a field equation.
